{
	"LOCAL": {
		"CLICKHOUSE_LOGGING": "false",
		"CLICKHOUSE_URL": "http://default:clickhouse@localhost:8124/analytics",
		"DATABASE_URL": "postgresql://starter:starter@localhost:54811/starter?schema=public",
		"MONGODB_URL": "mongodb://localhost:27811/starter",
		"ORDER_MAX_ATTEMPTS": "3",
		"ORDER_MAX_TOTAL": "10000",
		"ORDER_MIN_TOTAL": "10",
		"PLATFORM_ENV": "local",
		"PLATFORM_KEY": "local-admin-key",
		"PLATFORM_ORIGIN": "http://localhost:3800",
		"PORT": "9800",
		"POSTGRES_LOGGING": "false",
		"REDIS_URL": "redis://localhost:63811",
		"SENTRY_DSN": "",
		"SENTRY_TRACES_SAMPLE_RATE": "0.1",
		"SERVICE_TOKEN": ""
	},
	"TEST": {
		"CLICKHOUSE_LOGGING": "false",
		"CLICKHOUSE_URL": "http://default:clickhouse@localhost:8124/analytics",
		"DATABASE_URL": "postgresql://starter:starter@localhost:54811/starter_test?schema=public",
		"MONGODB_URL": "mongodb://localhost:27811/starter_test",
		"ORDER_MAX_ATTEMPTS": "3",
		"ORDER_MAX_TOTAL": "10000",
		"ORDER_MIN_TOTAL": "10",
		"PLATFORM_ENV": "test",
		"PLATFORM_KEY": "test-admin-key",
		"PLATFORM_ORIGIN": "http://localhost:3800",
		"PORT": "9801",
		"POSTGRES_LOGGING": "false",
		"REDIS_URL": "redis://localhost:63811/1",
		"SENTRY_DSN": "",
		"SENTRY_TRACES_SAMPLE_RATE": "0.1",
		"SERVICE_TOKEN": "test-service-token"
	},
	"PROD": {
		"CLICKHOUSE_LOGGING": "false",
		"CLICKHOUSE_URL": "${{ClickHouse.CLICKHOUSE_URL}}",
		"DATABASE_URL": "${{Postgres.DATABASE_URL}}",
		"MONGODB_URL": "${{MongoDB.MONGO_URL}}",
		"ORDER_MAX_ATTEMPTS": "3",
		"ORDER_MAX_TOTAL": "10000",
		"ORDER_MIN_TOTAL": "10",
		"PLATFORM_ENV": "production",
		"PLATFORM_KEY": "<секрет, задаётся в панели платформы>",
		"PLATFORM_ORIGIN": "https://твойдомен",
		"PORT": "${{PORT}}",
		"POSTGRES_LOGGING": "false",
		"REDIS_URL": "${{Redis.REDIS_URL}}",
		"SENTRY_DSN": "<dsn проекта>",
		"SENTRY_TRACES_SAMPLE_RATE": "0.1",
		"SERVICE_TOKEN": "<секрет, задаётся в панели платформы>",
		"_comment": "PROD-значения в файле НЕ живут: они задаются переменными окружения платформы. Этот блок — только карта того, ЧТО должно быть задано. ${{Service.VAR}} — ссылочная переменная Railway."
	}
}
