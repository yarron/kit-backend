<clickhouse>
  <!--
    ПОЛИТИКА (одинакова на всех окружениях).

    ClickHouse по умолчанию пишет про себя полтора десятка системных таблиц.
    На боевом инстансе это единственный источник, который растёт сам по себе,
    без единой вставки от приложения: у нас он занял 1.5 GiB на диске в 45 GiB
    и вытеснял данные.

    Ниже: уровень лога поднят до warning, ВСЕ системные логи удалены
    (remove="1"), кроме query_log — он единственный, который реально читают,
    когда разбираются, почему запрос медленный или упал по памяти.
    Ему поставлен TTL 3 дня.

    Префикс zz- в имени файла — не украшение: ClickHouse читает config.d
    в алфавитном порядке, и файл должен применяться ПОСЛЕ конфига образа.
  -->
  <logger>
    <level>warning</level>
  </logger>

  <query_log>
    <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
  </query_log>

  <text_log remove="1"/>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <error_log remove="1"/>
  <part_log remove="1"/>
  <processors_profile_log remove="1"/>
  <asynchronous_insert_log remove="1"/>
  <query_metric_log remove="1"/>
  <query_thread_log remove="1"/>
</clickhouse>
