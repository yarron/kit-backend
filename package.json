{
	"name": "nestjs-starter-kit",
	"version": "1.0.0",
	"description": "Production-shaped NestJS starter: GraphQL + Mongo + BullMQ + ClickHouse",
	"license": "UNLICENSED",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@9.1.3",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"prebuild": "pnpm check",
		"build": "nest build",
		"local": "env-cmd -e LOCAL nest start --debug --watch",
		"start": "TZ=utc node dist/main",
		"start:local": "env-cmd -e LOCAL node dist/main",
		"check": "biome check --write ./src ./test",
		"format": "biome format --write ./src ./test",
		"lint": "biome lint --write ./src ./test",
		"test": "jest --config jest.config.js --verbose",
		"test:unit": "jest --config jest.config.js --verbose",
		"test:watch": "jest --config jest.config.js --watch",
		"test:cov": "jest --config jest.config.js --coverage",
		"test:e2e": "env-cmd -e TEST jest --config jest-e2e.config.js --verbose --runInBand",
		"test:all": "pnpm test:unit && pnpm test:e2e",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"ch:migrate": "env-cmd -e LOCAL tsx scripts/clickhouse-migrate.ts local",
		"seed": "env-cmd -e LOCAL tsx scripts/seed.ts"
	},
	"dependencies": {
		"@apollo/server": "^5.2.0",
		"@bull-board/api": "^6.16.2",
		"@bull-board/express": "^6.16.2",
		"@bull-board/nestjs": "^6.16.2",
		"@clickhouse/client": "^1.22.0",
		"@hypequery/clickhouse": "^2.0.2",
		"@nestjs/apollo": "^13.2.3",
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/common": "^11.1.10",
		"@nestjs/core": "^11.1.10",
		"@nestjs/graphql": "^13.2.3",
		"@nestjs/mongoose": "^11.0.4",
		"@nestjs/platform-express": "^11.1.10",
		"@nestjs/schedule": "^5.0.1",
		"@nestjs/swagger": "^11.2.6",
		"@nestjs/terminus": "^11.0.0",
		"bullmq": "^5.66.4",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"dayjs": "^1.11.19",
		"express": "^4.22.1",
		"express-basic-auth": "^1.2.1",
		"graphql": "^16.12.0",
		"graphql-depth-limit": "^1.1.0",
		"helmet": "^8.1.0",
		"ioredis": "^5.9.2",
		"mongoose": "^8.20.4",
		"nestjs-redis-box": "^0.1.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@as-integrations/express5": "^1.1.2",
		"@biomejs/biome": "2.3.10",
		"@nestjs/cli": "^11.0.14",
		"@nestjs/schematics": "^11.0.9",
		"@nestjs/testing": "^11.1.10",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.19.3",
		"@types/supertest": "^6.0.3",
		"env-cmd": "^10.1.0",
		"jest": "^30.2.0",
		"only-allow": "^1.2.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.1.4",
		"terser-webpack-plugin": "^5.3.16",
		"ts-jest": "^29.4.6",
		"ts-loader": "^9.5.4",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsconfig-paths-webpack-plugin": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"webpack-node-externals": "^3.0.0"
	},
	"lint-staged": {
		"*.{js,ts}": [
			"pnpm check",
			"pnpm build"
		]
	}
}
